<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qcar_lane_perception</name>
  <version>0.1.0</version>
  <description>Lane detection pipeline for the QCar: CompressedImage decode + HLS lane detector that publishes target points, overlay/BEV/mask images.</description>
  <maintainer email="xyg122413@gmail.com">xyg</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
