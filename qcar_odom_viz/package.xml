<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qcar_odom_viz</name>
  <version>0.1.0</version>
  <description>
    Visualizacion en laptop de la odometria del QCar.
    Suscribe /odom (publicado por qcar_odom corriendo en el carro) y publica
    nav_msgs/Path con la traza acumulada. Lanza RViz2 con un layout que muestra
    Odometry + Path + TF.
  </description>

  <maintainer email="usuario@example.com">Desarrollador</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>rviz2</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
