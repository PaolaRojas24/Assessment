<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qcar_control</name>
  <version>0.1.0</version>
  <description>QCar command pipeline: command_mux + lane_follower configuration + bringup launch files. Every node that wants to move the QCar feeds this mux.</description>
  <maintainer email="xyg122413@gmail.com">xyg</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>control_helpers_pkg</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
