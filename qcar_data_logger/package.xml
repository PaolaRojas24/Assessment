<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qcar_data_logger</name>
  <version>0.1.0</version>
  <description>
    Registra la odometría del QCar (x, y, yaw) en un CSV.
    Suscribe /odom (nav_msgs/Odometry) y guarda los datos en modo
    continuo (por distancia mínima) o a tasa fija.
  </description>

  <maintainer email="usuario@example.com">Desarrollador</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
